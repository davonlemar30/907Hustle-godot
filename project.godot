; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="907Hustle-godot"
run/main_scene="res://ui/screens/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
GameState="*res://autoload/game_state.gd"
RngManager="*res://autoload/rng_manager.gd"
GameManager="*res://autoload/game_manager.gd"
ScreenManager="*res://autoload/screen_manager.gd"
Exposure="*res://autoload/exposure.gd"
Curtis="*res://autoload/curtis.gd"
SaveSystem="*res://autoload/save_system.gd"
Version="*res://autoload/version.gd"
SurfaceVisibility="*res://autoload/surface_visibility.gd"

[display]

window/size/viewport_width=375
window/size/viewport_height=812
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; ANDR-D3: the rendering METHOD stays untouched above (still gl_compatibility,
; same as before this preset existed) -- this is a texture IMPORT flag, not a
; rendering-method or display change. Godot's Android export refuses outright
; without an ETC2/ASTC-compressed variant available for at least one texture;
; the project has only ever imported the desktop-oriented S3TC/BPTC variant
; (Web's preset.0 already opts into that one explicitly via
; vram_texture_compression/for_desktop). Purely additive: it adds a second
; compressed variant at import time and changes nothing about which variant
; an existing preset requests -- Web's preset.0 still reads
; for_desktop=true/for_mobile=false and is unaffected.
;
; MUST use ";" here, not "#": a "#" comment anywhere inside this SAME section
; silently breaks a not-yet-engine-registered key's parsing in this Godot
; build (confirmed directly -- reproduced in a from-scratch minimal project,
; a bare "#" comment anywhere in [rendering] resolved this exact setting to
; false even with the key itself spelled correctly with no comment adjacent
; to it; switching the comment to ";" fixed it every time). This project's
; own file header (top of this file) already uses ";" for exactly this
; reason -- "#" is the wrong comment character for project.godot specifically,
; unlike every .gd/.cfg/.yml file in this repo where "#" is correct.
textures/vram_compression/import_etc2_astc=true
